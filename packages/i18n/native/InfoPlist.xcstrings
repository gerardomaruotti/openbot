{
  "sourceLanguage": "en",
  "strings": {
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to OpenBot on your Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collegati a OpenBot sul tuo Mac."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo to attach to your message."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scatta una foto da allegare al messaggio."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the microphone to dictate a message draft on this device."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il microfono per dettare una bozza del messaggio su questo dispositivo."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn your voice into a message draft on this device. You review the text before sending."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma la tua voce in una bozza del messaggio su questo dispositivo. Controlla il testo prima di inviarlo."
          }
        }
      }
    }
  },
  "version": "1.0"
}
